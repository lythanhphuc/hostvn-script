    printf "${RED}%s${NC}" "Ban dang su dung phien ban ${OS} ${OS_VER}."
    printf "${RED}%s${NC}" "Hien tai Scripts chi ho tro Ubuntu 22.04, 24.04."
    printf "${RED}%s${NC}" "Huy cai dat."
    exit
fi
